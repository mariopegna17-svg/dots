# Introduce la clave SOLO en tu .env local (ignorado por Git) o en ajustes seguros.
NVIDIA_API_KEY=
MODEL_API_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_WIRE_API=chat_completions
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
COMPUTER_PROVIDER=docker
APP_TIMEZONE=Europe/Madrid
# Opcional: COMPOSIO_API_KEY para conectores, YDC_API_KEY para mayor cuota de búsqueda.
# DATA_DIR y WORKSPACE_ROOT usan rutas locales seguras por defecto.
# Producción: HTTPS, AUTH_COOKIE_SECURE=1 y CORS_ORIGINS con tu origen exacto.

# WhatsApp por QR: activado de fábrica; sin Twilio. Se conecta desde la web.
WHATSAPP_QR_ENABLED=1
# Llamadas/WhatsApp con Twilio (opcional): el modo Trial sirve.
# En Render Free, usa Environment para conservar los valores al desplegar.
COMMUNICATIONS_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OWNER_PHONE_NUMBER=
TWILIO_VOICE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Render proporciona RENDER_EXTERNAL_URL automáticamente; no añadas /app.
COMMUNICATION_PUBLIC_URL=
# Opcional: se usa el primer Dot si no se selecciona otro.
COMMUNICATION_BOT_ID=

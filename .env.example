# Introduce la clave SOLO en tu .env local (ignorado por Git) o en ajustes seguros.
NVIDIA_API_KEY=
MODEL_API_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_WIRE_API=chat_completions
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
COMPUTER_PROVIDER=docker
APP_TIMEZONE=Europe/Madrid
# Opcional: COMPOSIO_API_KEY para conectores, YDC_API_KEY para mayor cuota de búsqueda.
# DATA_DIR y WORKSPACE_ROOT usan rutas locales seguras por defecto.
# Producción: HTTPS, AUTH_COOKIE_SECURE=1 y CORS_ORIGINS con tu origen exacto.
